{
  "name": "blockchain-learning-path",
  "version": "0.7.0",
  "private": true,
  "description": "Ruta práctica en español para aprender blockchain desde nivel inicial hasta producción",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node scripts/check-repository.mjs",
    "lint:js": "eslint .",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "build:landing": "node scripts/build-landing.mjs",
    "build:site": "node scripts/build-site.mjs",
    "build:manual": "node scripts/build-manual.mjs && node scripts/render-manual-pdf.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "build:bundle": "node scripts/build-app-bundle.mjs",
    "app:windows": "pnpm build:bundle && pnpm --filter @blockchain-course/desktop dist",
    "app:windows:verify": "node scripts/verify-desktop.mjs",
    "app:android": "pnpm build:bundle && pnpm --filter @blockchain-course/android sync && pnpm --filter @blockchain-course/android exec node personalizar.mjs && pnpm --filter @blockchain-course/android apk",
    "app:android:verify": "node apps/android/verificar-apk.mjs",
    "lab:hash": "node labs/01-cryptography/hash-chain.mjs",
    "lab:merkle": "node labs/01-cryptography/merkle-tree.mjs",
    "lab:pow": "node labs/02-consensus/proof-of-work.mjs",
    "lab:utxo": "node labs/04-bitcoin/utxo-selection.mjs",
    "lab:abi": "node labs/05-evm/abi-selector.mjs",
    "lab:tokenomics": "node labs/15-tokenomics/supply-simulator.mjs",
    "serve": "node apps/learning-dashboard/server.mjs",
    "build:web": "pnpm --filter @blockchain-course/community-funding-web build",
    "test:indexer": "pnpm --filter @blockchain-course/event-indexer test",
    "test": "node scripts/run-tests.mjs",
    "course:status": "node scripts/course-status.mjs",
    "course:diagnostic": "node scripts/run-diagnostic.mjs",
    "course:certificate": "node scripts/generate-certificate.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "marked": "^12.0.2",
    "puppeteer-core": "^23.11.1"
  }
}
