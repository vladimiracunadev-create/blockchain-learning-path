# Normaliza los finales de línea: el repositorio se edita en Windows, macOS y
# Linux, pero se versiona con LF para que la CI y los diffs sean estables.
* text=auto eol=lf

# Scripts que deben conservar LF sí o sí.
*.mjs   text eol=lf
*.js    text eol=lf
*.ts    text eol=lf
*.sol   text eol=lf
*.sh    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Binarios: nunca aplicar normalización.
*.png   binary
*.jpg   binary
*.pdf   binary
*.ico   binary
